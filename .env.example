# Copy this file to .env and uncomment/edit any values you want to override.
# None of these are required -- app.py has working defaults for all of them.
# .env is git-ignored, so it's safe to put machine-specific values here.

# Where your TripoSR checkout lives, if not ./TripoSR next to app.py
# TRIPOSR_DIR=/opt/TripoSR

# Renderer chunk size TripoSR uses internally. Lower it (e.g. 8192, the
# upstream default) on a memory-constrained machine; raise it if you have
# RAM to spare and want to trade memory for a bit of speed.
# TRIPOSR_CHUNK_SIZE=32768

# Which rembg background-removal model to use. isnet-general-use (the
# default here) gives cleaner silhouettes than rembg's own default
# (u2net) on most product/object photos.
# REMBG_MODEL=isnet-general-use
